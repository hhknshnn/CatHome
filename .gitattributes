# Keep repository text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Unity and project text assets.
*.asmdef text eol=lf
*.asmref text eol=lf
*.anim text eol=lf
*.asset text eol=lf
*.cginc text eol=lf
